[Unit]
Description=Aegis-DB Dashboard Server
After=network.target

[Service]
Type=simple
User=devops
WorkingDirectory=/opt/Aegis-DB
ExecStart=/opt/Aegis-DB/target/release/aegis-server --port 9090 --node-name Dashboard --peers 127.0.0.1:9091,127.0.0.1:7001
Restart=always
RestartSec=5
Environment=RUST_LOG=info
# v0.3.1 is fail-closed: provision an admin (AEGIS_ADMIN_USERNAME/PASSWORD) or set
# AEGIS_OPEN_BOOTSTRAP=true here, else authenticated routes return 503 until a user exists.
EnvironmentFile=-/etc/aegis/aegis.env

[Install]
WantedBy=multi-user.target
